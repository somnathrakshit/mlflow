":"TVt4lRnQce"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Autologging","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"BvoVf6FjOG"}],"key":"l2v6LhBKyn"},{"type":"text","value":", ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JtHlWRjQF2"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Artifacts","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"tyZhz5rIZz"}],"key":"TEbD1ZPXFv"},{"type":"text","value":", and ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ootqoSPKVQ"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Nested Runs","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PdjERThFxC"}],"key":"hEHPpECBE7"},{"type":"text","value":" for complex experiments.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"x9UjY1fiqK"}],"key":"Mk8HJbnazn"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"1. The Power of Autologging","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"M6T0FTwJ2s"}],"identifier":"id-1-the-power-of-autologging","label":"1. The Power of Autologging","html_id":"id-1-the-power-of-autologging","implicit":true,"key":"o29DxGpwBb"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Writing ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"t1hRuPvmo6"},{"type":"inlineCode","value":"mlflow.log_param","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"daUfYBWeDa"},{"type":"text","value":" for every variable is tedious. MLflow’s ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"PvnoFFktzv"},{"type":"inlineCode","value":"autolog()","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"I6JZSOb3Sx"},{"type":"text","value":" feature automatically captures parameters, metrics, and models for popular libraries (Scikit-Learn, TensorFlow, PyTorch, XGBoost, etc.).","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"v2p623Xveb"}],"key":"NdGHhd1p0C"}],"key":"Eoi4lFaVb4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import mlflow\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.datasets import load_iris\nfrom sklearn.model_selection import train_test_split\n\n# Enable autologging for scikit-learn\nmlflow.sklearn.autolog()\n\ndb = load_iris()\nX_train, X_test, y_train, y_test = train_test_split(db.data, db.target)\n\nwith mlflow.start_run(run_name=\"Autologging_Example\"):\n    clf = RandomForestClassifier(n_estimators=100, max_depth=5)\n    clf.fit(X_train, y_train)\n    # No need to log metrics manually! Autolog handles it.","key":"lvpeL4nWtr"},{"type":"outputs","id":"d-E6w_L7d_pMsr3A0wP10","children":[],"key":"A6vfl3MjEP"}],"key":"ffkePN3dmP"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Manual Logging: Artifacts and Dataframes","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ixbntQGB9u"}],"identifier":"id-2-manual-logging-artifacts-and-dataframes","label":"2. Manual Logging: Artifacts and Dataframes","html_id":"id-2-manual-logging-artifacts-and-dataframes","implicit":true,"key":"SMEDQk9Phy"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Sometimes you need to log custom items like feature importance plots or CSV summaries.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"NsgfuoPfG6"}],"key":"qGP097dFTA"}],"key":"oZX0B7CCw1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport pandas as pd\nimport numpy as np\n\nwith mlflow.start_run(run_name=\"Custom_Artifacts\"):\n    # 1. Log a simple text file\n    with open(\"features.txt\", \"w\") as f:\n        f.write(\"sepal length, sepal width, petal length, petal width\")\n    mlflow.log_artifact(\"features.txt\")\n    \n    # 2. Log a Plotly/Matplotlib figure directly\n    fig, ax = plt.subplots()\n    ax.plot([0, 1, 2], [10, 20, 30])\n    ax.set_title(\"Training Progress\")\n    mlflow.log_figure(fig, \"plots/progress_chart.png\")\n    \n    # 3. Log a Dictionary as JSON\n    config = {\"batch_size\": 32, \"optimizer\": \"adam\", \"layers\": [64, 32]}\n    mlflow.log_dict(config, \"configs/hyperparams.json\")","key":"efHaNxTRbs"},{"type":"outputs","id":"O6AUebVcBKgAIKW9ooOUA","children":[],"key":"HPnc2Qy21M"}],"key":"IrA0H0gguV"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Organizing with Nested Runs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JoJHNG7umO"}],"identifier":"id-3-organizing-with-nested-runs","label":"3. Organizing with Nested Runs","html_id":"id-3-organizing-with-nested-runs","implicit":true,"key":"crQ4RHCLlY"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"When doing Hyperparameter Tuning, you don’t want 100 individual runs cluttering your UI. You want one parent run with many children.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"gYN162YTH6"}],"key":"PTHApq6Elq"}],"key":"WquVBlyDml"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def train_model(n_estimators):\n    with mlflow.start_run(run_name=f\"Estimators_{n_estimators}\", nested=True):\n        # ... training logic ...\n        mlflow.log_param(\"n_estimators\", n_estimators)\n        mlflow.log_metric(\"score\", np.random.random())\n\nwith mlflow.start_run(run_name=\"Grid_Search_Parent\"):\n    for n in [10, 50, 100]:\n        train_model(n)","key":"D7dcRxaM6M"},{"type":"outputs","id":"FQlynLb34v0HlXm9K9TnE","children":[],"key":"ZvNu6FexzQ"}],"key":"AeuwzLHvlV"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Best Practice: Tags","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IzQVVoWSzU"}],"identifier":"id-4-best-practice-tags","label":"4. Best Practice: Tags","html_id":"id-4-best-practice-tags","implicit":true,"key":"TPvUT9iTUG"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Tags are searchable metadata. Use them to label runs with ‘production_candidate’, ‘baseline’, or the name of the data scientist.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"r0xmoPl3JZ"}],"key":"bS6dWr6NdH"}],"key":"yw292T4H8n"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mlflow.set_tag(\"release.version\", \"2.1.0\")\nmlflow.set_tag(\"model_type\", \"ensemble\")","key":"ua6cjieiAF"},{"type":"outputs","id":"DeH8I5Ak6av4edbcj7Leq","children":[],"key":"mMjyJeKAUk"}],"key":"RHqIpGBOxB"}],"key":"MdhlN7XAvo"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Setting Up a Professional MLOps Environment","url":"/lessons/setup","group":"Getting Started"},