":"EVS34XmXeR"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Autologging","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"brV1CO5E5r"}],"key":"oDyxOEs3LC"},{"type":"text","value":", ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"yW7Xeg10CU"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Artifacts","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pOkyDtvPD8"}],"key":"ngP5jV4yVG"},{"type":"text","value":", and ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"RUA3o6a3yr"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Nested Runs","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qOcTejxVvr"}],"key":"UMU3obBh0C"},{"type":"text","value":" for complex experiments.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"SabuQ5IXl5"}],"key":"h8soq0n5UZ"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"1. The Power of Autologging","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"cEXRME1TXt"}],"identifier":"id-1-the-power-of-autologging","label":"1. The Power of Autologging","html_id":"id-1-the-power-of-autologging","implicit":true,"key":"fqNmo0YKjJ"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Writing ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"zK5DyAfpVD"},{"type":"inlineCode","value":"mlflow.log_param","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"Qs2GhzYH9R"},{"type":"text","value":" for every variable is tedious. MLflow’s ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"S4FBdbrNV3"},{"type":"inlineCode","value":"autolog()","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"XlAMfRpv7v"},{"type":"text","value":" feature automatically captures parameters, metrics, and models for popular libraries (Scikit-Learn, TensorFlow, PyTorch, XGBoost, etc.).","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"aQCjr3KM71"}],"key":"u2p1QPGsJW"}],"key":"OKA33G3SLz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import mlflow\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.datasets import load_iris\nfrom sklearn.model_selection import train_test_split\n\n# Enable autologging for scikit-learn\nmlflow.sklearn.autolog()\n\ndb = load_iris()\nX_train, X_test, y_train, y_test = train_test_split(db.data, db.target)\n\nwith mlflow.start_run(run_name=\"Autologging_Example\"):\n    clf = RandomForestClassifier(n_estimators=100, max_depth=5)\n    clf.fit(X_train, y_train)\n    # No need to log metrics manually! Autolog handles it.","key":"eWMVd6nL3b"},{"type":"outputs","id":"_WlQuo-b95heCd1G-i9OQ","children":[],"key":"f9fHbHktAw"}],"key":"LyeHLH5add"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Manual Logging: Artifacts and Dataframes","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ohDnPu84jF"}],"identifier":"id-2-manual-logging-artifacts-and-dataframes","label":"2. Manual Logging: Artifacts and Dataframes","html_id":"id-2-manual-logging-artifacts-and-dataframes","implicit":true,"key":"A9p1Sl0JrJ"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Sometimes you need to log custom items like feature importance plots or CSV summaries.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ffidUMjGP6"}],"key":"RjBuVnJFGX"}],"key":"m7NTw0TBok"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport pandas as pd\nimport numpy as np\n\nwith mlflow.start_run(run_name=\"Custom_Artifacts\"):\n    # 1. Log a simple text file\n    with open(\"features.txt\", \"w\") as f:\n        f.write(\"sepal length, sepal width, petal length, petal width\")\n    mlflow.log_artifact(\"features.txt\")\n    \n    # 2. Log a Plotly/Matplotlib figure directly\n    fig, ax = plt.subplots()\n    ax.plot([0, 1, 2], [10, 20, 30])\n    ax.set_title(\"Training Progress\")\n    mlflow.log_figure(fig, \"plots/progress_chart.png\")\n    \n    # 3. Log a Dictionary as JSON\n    config = {\"batch_size\": 32, \"optimizer\": \"adam\", \"layers\": [64, 32]}\n    mlflow.log_dict(config, \"configs/hyperparams.json\")","key":"ugGZQo0TMd"},{"type":"outputs","id":"vUCoUbB-5WJdpbn4ZQuq7","children":[],"key":"r4oqDknA1u"}],"key":"eIK9Wa12lP"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Organizing with Nested Runs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CBhiBqeDel"}],"identifier":"id-3-organizing-with-nested-runs","label":"3. Organizing with Nested Runs","html_id":"id-3-organizing-with-nested-runs","implicit":true,"key":"M4JiTA5WwN"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"When doing Hyperparameter Tuning, you don’t want 100 individual runs cluttering your UI. You want one parent run with many children.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Qh6JXPQaRm"}],"key":"AmwxWsLpvS"}],"key":"rXFtqPQ0EQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def train_model(n_estimators):\n    with mlflow.start_run(run_name=f\"Estimators_{n_estimators}\", nested=True):\n        # ... training logic ...\n        mlflow.log_param(\"n_estimators\", n_estimators)\n        mlflow.log_metric(\"score\", np.random.random())\n\nwith mlflow.start_run(run_name=\"Grid_Search_Parent\"):\n    for n in [10, 50, 100]:\n        train_model(n)","key":"tMm5iWwMVX"},{"type":"outputs","id":"ZXks3qo39weUwdEtJkkp1","children":[],"key":"cO9AoxGehg"}],"key":"v1MdipvbgL"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Best Practice: Tags","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qysAWE4gcf"}],"identifier":"id-4-best-practice-tags","label":"4. Best Practice: Tags","html_id":"id-4-best-practice-tags","implicit":true,"key":"IMSM41nF9V"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Tags are searchable metadata. Use them to label runs with ‘production_candidate’, ‘baseline’, or the name of the data scientist.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"d2KNZfCVZ7"}],"key":"PUTdrw8wO3"}],"key":"MQkyrTbzJp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mlflow.set_tag(\"release.version\", \"2.1.0\")\nmlflow.set_tag(\"model_type\", \"ensemble\")","key":"whSmlzVDo0"},{"type":"outputs","id":"LU_7JamMBQjmsGClpDwWt","children":[],"key":"Pc8YNxLurr"}],"key":"sfXKQrSZ83"}],"key":"Pm9RwBq4fp"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Setting Up a Professional MLOps Environment","url":"/lessons/setup","group":"Getting Started"},