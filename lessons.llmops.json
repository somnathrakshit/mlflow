{"version":3,"kind":"Notebook","sha256":"79e54d499a2fb073acc46452411d7c3fa582aea2b45007dc9fccb69cbbbb0e01","slug":"lessons.llmops","location":"/lessons/llmops.ipynb","dependencies":[],"frontmatter":{"title":"Advanced LLMOps with MLflow Tracing","content_includes_title":true,"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"authors":[{"nameParsed":{"literal":"MLflow Enthusiast","given":"MLflow","family":"Enthusiast"},"name":"MLflow Enthusiast","id":"contributors-Users\\mxz\\Documents\\GitHub\\mlflow\\myst-generated-uid-0"}],"github":"https://github.com/user/mlflow-tutorial","numbering":{"title":{"offset":1}},"exports":[{"format":"ipynb","filename":"llmops.ipynb","url":"/build/llmops-719d8f4b0dd238380f9419b39c33a0a2.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Install dependencies if running in Google Colab\ntry:\n    import google.colab\n    !pip install mlflow langchain langchain-openai openai\nexcept ImportError:\n    pass","key":"miQhdPIxqz"},{"type":"outputs","id":"FDIVPqeLajurYaG-E9B-a","children":[],"key":"QyR0QXfP4K"}],"key":"wqHIkNH5iG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":1,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Advanced LLMOps with MLflow Tracing","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WSZGRloG5b"}],"identifier":"advanced-llmops-with-mlflow-tracing","label":"Advanced LLMOps with MLflow Tracing","html_id":"advanced-llmops-with-mlflow-tracing","implicit":true,"key":"KmH2McoplJ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Logging strings in a table isn’t enough for LLMs. You need to see the internal “thought process” of your chains and agents. MLflow Tracing provides this visibility.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OQQLav2D98"}],"key":"eWLVrL7uA7"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"1. Automatic Tracing for LangChain","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"y8h2JH0YP7"}],"identifier":"id-1-automatic-tracing-for-langchain","label":"1. Automatic Tracing for LangChain","html_id":"id-1-automatic-tracing-for-langchain","implicit":true,"key":"FEFkq0N829"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"If you use LangChain, MLflow can instrument the entire chain automatically.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"fpZpy1hdY2"}],"key":"Mpj2iTtTgF"}],"key":"CwMqriOCdq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import mlflow\nfrom langchain.prompts import PromptTemplate\nfrom langchain_openai import ChatOpenAI\n\n# Enable autologging for LangChain\nmlflow.langchain.autolog()\n\nllm = ChatOpenAI(model_name=\"gpt-4o\")\nprompt = PromptTemplate.from_template(\"Summarize this: {text}\")\nchain = prompt | llm\n\n# This will create a Trace in MLflow UI showing the Prompt construction and LLM call\nchain.invoke({\"text\": \"MLflow is an open-source platform for the machine learning lifecycle...\"})","key":"vaaR3Jnsja"},{"type":"outputs","id":"Q-o5hoW_OwPjG6cIHtAJ0","children":[],"key":"YJG28Q1bYN"}],"key":"BL5DvBW4Zd"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Manual Tracing with Custom Spans","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jiiY91lIPB"}],"identifier":"id-2-manual-tracing-with-custom-spans","label":"2. Manual Tracing with Custom Spans","html_id":"id-2-manual-tracing-with-custom-spans","implicit":true,"key":"VcwpZu4hn2"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"For complex apps involving database lookups or custom logic, use the ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"OZFF2POdwD"},{"type":"inlineCode","value":"@mlflow.trace","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Qvhqm7eMVW"},{"type":"text","value":" decorator.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"rwmbIbH76X"}],"key":"kQ8INjDL5q"}],"key":"ujGu9jliWc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from mlflow.entities import SpanType\n\n@mlflow.trace(name=\"Knowledge_Base_Search\", span_type=SpanType.RETRIEVER)\ndef search_db(query):\n    # Simulate a DB lookup\n    return \"Found: MLflow 2.14 supports Tracing.\"\n\n@mlflow.trace(name=\"AI_Agent\", span_type=SpanType.AGENT)\ndef run_agent(query):\n    context = search_db(query)\n    # ... logic to call LLM with context ...\n    return \"The latest version of MLflow is 2.14.\"\n\nrun_agent(\"What is the latest MLflow?\")","key":"peqPKjmegx"},{"type":"outputs","id":"j_jvp0dplU3DXknkMHDTs","children":[],"key":"SfKs8o8kWV"}],"key":"dzY4MZ2l19"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Evaluating LLMs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nFRbUqDjGK"}],"identifier":"id-3-evaluating-llms","label":"3. Evaluating LLMs","html_id":"id-3-evaluating-llms","implicit":true,"key":"BLw035BObx"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"MLflow also provides ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"czpbiYKlLG"},{"type":"inlineCode","value":"mlflow.evaluate()","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"XmpWJWbY0i"},{"type":"text","value":" to run automated benchmarks against your traces using metrics like ‘faithfulness’ or ‘answer_relevance’.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"aM7wMQMIIW"}],"key":"OvwHAXRJBp"}],"key":"CaHLguzxOE"}],"key":"hjo7oXYvL4"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Serving Models for Production","url":"/lessons/serving","group":"Phase 3 - Advanced"},"next":{"title":"Pipeline Orchestration & Quality Gates","url":"/lessons/orchestration","group":"Phase 3 - Advanced"}}},"domain":"http://localhost:3000"}