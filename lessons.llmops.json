{"version":3,"kind":"Notebook","sha256":"79e54d499a2fb073acc46452411d7c3fa582aea2b45007dc9fccb69cbbbb0e01","slug":"lessons.llmops","location":"/lessons/llmops.ipynb","dependencies":[],"frontmatter":{"title":"Advanced LLMOps with MLflow Tracing","content_includes_title":true,"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"authors":[{"nameParsed":{"literal":"MLflow Enthusiast","given":"MLflow","family":"Enthusiast"},"name":"MLflow Enthusiast","id":"contributors-Users\\mxz\\Documents\\GitHub\\mlflow\\myst-generated-uid-0"}],"github":"https://github.com/user/mlflow-tutorial","numbering":{"title":{"offset":1}},"exports":[{"format":"ipynb","filename":"llmops.ipynb","url":"/build/llmops-719d8f4b0dd238380f9419b39c33a0a2.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Install dependencies if running in Google Colab\ntry:\n    import google.colab\n    !pip install mlflow langchain langchain-openai openai\nexcept ImportError:\n    pass","key":"LlceBpDIHn"},{"type":"outputs","id":"2RWYHv9nJgCUbbRXRdzdF","children":[],"key":"DIznKlQJTf"}],"key":"JyP0ZTbeF6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":1,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Advanced LLMOps with MLflow Tracing","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"M7HYtTwpFp"}],"identifier":"advanced-llmops-with-mlflow-tracing","label":"Advanced LLMOps with MLflow Tracing","html_id":"advanced-llmops-with-mlflow-tracing","implicit":true,"key":"tC1wIVJXac"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Logging strings in a table isn’t enough for LLMs. You need to see the internal “thought process” of your chains and agents. MLflow Tracing provides this visibility.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"G31c1sKYDz"}],"key":"kmXek41Okt"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"1. Automatic Tracing for LangChain","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"sEVTMSQrWe"}],"identifier":"id-1-automatic-tracing-for-langchain","label":"1. Automatic Tracing for LangChain","html_id":"id-1-automatic-tracing-for-langchain","implicit":true,"key":"tk0EXhLPuW"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"If you use LangChain, MLflow can instrument the entire chain automatically.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"bxqwHemnx6"}],"key":"k1kHPGDwNj"}],"key":"wmbMExOHYM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import mlflow\nfrom langchain.prompts import PromptTemplate\nfrom langchain_openai import ChatOpenAI\n\n# Enable autologging for LangChain\nmlflow.langchain.autolog()\n\nllm = ChatOpenAI(model_name=\"gpt-4o\")\nprompt = PromptTemplate.from_template(\"Summarize this: {text}\")\nchain = prompt | llm\n\n# This will create a Trace in MLflow UI showing the Prompt construction and LLM call\nchain.invoke({\"text\": \"MLflow is an open-source platform for the machine learning lifecycle...\"})","key":"OjXlzmHJNP"},{"type":"outputs","id":"buvW7jfhbx_FobxALPsSZ","children":[],"key":"t5843Pvl1d"}],"key":"JGk6Q4NoOj"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Manual Tracing with Custom Spans","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"I0uIN1EOmX"}],"identifier":"id-2-manual-tracing-with-custom-spans","label":"2. Manual Tracing with Custom Spans","html_id":"id-2-manual-tracing-with-custom-spans","implicit":true,"key":"yhKUjKuVJf"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"For complex apps involving database lookups or custom logic, use the ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"AEVZaWkpDT"},{"type":"inlineCode","value":"@mlflow.trace","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"mEqlB9jaBE"},{"type":"text","value":" decorator.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"nedsYXwYem"}],"key":"lIlDGXykig"}],"key":"mqPo03LRWz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from mlflow.entities import SpanType\n\n@mlflow.trace(name=\"Knowledge_Base_Search\", span_type=SpanType.RETRIEVER)\ndef search_db(query):\n    # Simulate a DB lookup\n    return \"Found: MLflow 2.14 supports Tracing.\"\n\n@mlflow.trace(name=\"AI_Agent\", span_type=SpanType.AGENT)\ndef run_agent(query):\n    context = search_db(query)\n    # ... logic to call LLM with context ...\n    return \"The latest version of MLflow is 2.14.\"\n\nrun_agent(\"What is the latest MLflow?\")","key":"kJuBuCvF0H"},{"type":"outputs","id":"LagTwraoJwYqerpPrOV5B","children":[],"key":"FcMKYYdZ68"}],"key":"WfLf32KSdp"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Evaluating LLMs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bM38SoAcrx"}],"identifier":"id-3-evaluating-llms","label":"3. Evaluating LLMs","html_id":"id-3-evaluating-llms","implicit":true,"key":"B7XkPvwHrj"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"MLflow also provides ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"asQ4hTb97z"},{"type":"inlineCode","value":"mlflow.evaluate()","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"AbTk2cQKXd"},{"type":"text","value":" to run automated benchmarks against your traces using metrics like ‘faithfulness’ or ‘answer_relevance’.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"DcFEDJ0Y1s"}],"key":"Nw1ogu8tgO"}],"key":"hTTi0WQ8bO"}],"key":"h3oqgq8rzC"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Serving Models for Production","url":"/lessons/serving","group":"Phase 3 - Advanced"},"next":{"title":"Pipeline Orchestration & Quality Gates","url":"/lessons/orchestration","group":"Phase 3 - Advanced"}}},"domain":"http://localhost:3000"}