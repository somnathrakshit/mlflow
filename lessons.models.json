GqHU"},{"type":"outputs","id":"nLEMm1z7MZXmejqEHP9pb","children":[],"key":"rjI5e80dCF"}],"key":"KH9Jg9Zi3p"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Custom PyFunc Models","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LLFeSZ9GOQ"}],"identifier":"id-2-custom-pyfunc-models","label":"2. Custom PyFunc Models","html_id":"id-2-custom-pyfunc-models","implicit":true,"key":"fez9uVENpv"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Sometimes your model requires a special preprocessing step (e.g., standardizing text or handling missing values) that isn’t part of the sklearn pipeline. You can wrap it in an ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"aj8vcb0x2N"},{"type":"inlineCode","value":"mlflow.pyfunc","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"tEKFILE8wa"},{"type":"text","value":".","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"cZ7iFbwHm3"}],"key":"VuoJqaauDe"}],"key":"pCkdtYwlSG"},{"type":"block","kind":"notebook-code","data":{"vscode":{"languageId":"markdown"}},"children":[{"type":"code","lang":"python","executable":true,"value":"class CustomModelWrapper(mlflow.pyfunc.PythonModel):\n    def load_context(self, context):\n        # Load additional data like vocabularies if needed\n        pass\n\n    def predict(self, context, model_input):\n        # Custom logic: Preprocessing -> Prediction -> Postprocessing\n        processed_input = model_input.apply(lambda x: x * 1.05) # dummy preprocessing\n        return self.model.predict(processed_input)\n\n# Log the custom wrapper\n# mlflow.pyfunc.log_model(artifact_path=\"custom_model\", python_model=CustomModelWrapper())","key":"lxipCVfK2i"},{"type":"outputs","id":"bx3nITAqHTrYJBpD0tEdk","children":[],"key":"PpxqnjzOWa"}],"key":"dUCvC1dSGU"}],"key":"ReAwkehPHE"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Reproducible Packaging with MLflow Projects","url":"/lessons/projects","group":"Phase 1 - Foundations"},"next":{"title":"The Model Registry & Lifecycle","url":"/lessons/registry","group":"Phase 2 - Intermediate"}}},"domain":"http://localhost:3000"}