gXsg"},{"type":"outputs","id":"omPR6YK9i7lIEXlyGmxaV","children":[],"key":"NQ1NAYN6q4"}],"key":"uxyj5yMgUo"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Custom PyFunc Models","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qOZxlA0Z6P"}],"identifier":"id-2-custom-pyfunc-models","label":"2. Custom PyFunc Models","html_id":"id-2-custom-pyfunc-models","implicit":true,"key":"oPRkVsi70K"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Sometimes your model requires a special preprocessing step (e.g., standardizing text or handling missing values) that isn’t part of the sklearn pipeline. You can wrap it in an ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"CHZ8XiWJlf"},{"type":"inlineCode","value":"mlflow.pyfunc","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"l4E8D0XqsD"},{"type":"text","value":".","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"rzPDX6aSiv"}],"key":"RKwOqxdfvi"}],"key":"hylKj7Ju5B"},{"type":"block","kind":"notebook-code","data":{"vscode":{"languageId":"markdown"}},"children":[{"type":"code","lang":"python","executable":true,"value":"class CustomModelWrapper(mlflow.pyfunc.PythonModel):\n    def load_context(self, context):\n        # Load additional data like vocabularies if needed\n        pass\n\n    def predict(self, context, model_input):\n        # Custom logic: Preprocessing -> Prediction -> Postprocessing\n        processed_input = model_input.apply(lambda x: x * 1.05) # dummy preprocessing\n        return self.model.predict(processed_input)\n\n# Log the custom wrapper\n# mlflow.pyfunc.log_model(artifact_path=\"custom_model\", python_model=CustomModelWrapper())","key":"Wr9ACjoQYP"},{"type":"outputs","id":"A