[Unit]
Description: MLflow Tracking Server
After=network.target

[Service]
# User and Group should be updated to match your Linux user
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/mlflow-tutorial
# Ensure uv is installed on the server.
# ExecStart uses 'uv run' to start the server in the project's environment.
ExecStart=/usr/local/bin/uv run mlflow server --host 0.0.0.0 --port 5000 --backend-store-uri sqlite:///mlflow.db --default-artifact-root ./artifacts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
